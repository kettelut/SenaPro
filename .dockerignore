# ============================================
# SenaPro - Docker Ignore File
# ============================================
# Este arquivo exclui arquivos desnecessários do contexto de build do Docker,
# reduzindo tempo de build e tamanho da imagem.

# ============================================
# .NET / C# Build Artifacts
# ============================================
[Ss]ettings*
[Dd]ebug/
[Rr]elease/x64/
[Rr]elease/x86/
[Rr]elease/[Bb]in/
[Rr]elease/[Oo]bj/
[Bb]in/
[Oo]bj/
[Ll]ogs/
*.user
*.suo
*.cache
*.pdb
*.ipdb
*.iobj
*.dll
*.exe

# ============================================
# Visual Studio / IDE
# ============================================
.vs/
.idea/
*.sln.docstates

# ============================================
# Node.js / Angular Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
dist/

# ============================================
# Git
# ============================================
.git/
.gitignore
.gitattributes

# ============================================
# Documentation (não necessário em builds)
# ============================================
docs/
README.md
LICENSE
CHANGELOG.md
CLAUDE.md

# ============================================
# Testes
# ============================================
[Ss]enaPro.Tests/
[Tt]est[Rr]esult*/
coverage/
*.coveragexml
*.trx

# ============================================
# Docker (evita build circular)
# ============================================
docker-compose.yml
Dockerfile*
.dockerignore

# ============================================
# Arquivos de sistema operacional
# ============================================
Thumbs.db
.DS_Store
desktop.ini

# ============================================
# Arquivos temporários
# ============================================
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================
# Ambiente e credenciais
# ============================================
.env
.env.*
!.env.example
